# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- LLM reviewer (Groq — OpenAI-compatible, free tier) ---
# Get a free key at https://console.groq.com  ->  API Keys
GROQ_API_KEY=

# --- Review behaviour ---
# baseline (no key, deterministic) | llm | specialists
REVIEW_MODE=baseline
# Optional daily budget cap (USD); the LLM is hard-blocked once spend reaches it (ADR-004).
DAILY_CAP_USD=

# --- GitHub App / token (production ingress) ---
# HMAC secret you set when creating the GitHub App webhook.
GITHUB_WEBHOOK_SECRET=
# Token to fetch diffs and post reviews (GitHub App installation token, or a PAT for testing).
GITHUB_TOKEN=

# --- Tiger Cloud / Postgres data spine (optional; in-memory fallback if unset) ---
# Create a free service at https://console.cloud.tigerdata.com  (new accounts get credit).
TIGER_DATABASE_URL=

# --- Redis / ARQ (optional; in-process BackgroundTask fallback if unset) ---
REDIS_URL=redis://localhost:6379

# --- Server ---
PORT=8000
