# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# --- M2: LLM reviewer (Groq — OpenAI-compatible, free tier) ---
# Get a free key at https://console.groq.com  ->  API Keys
GROQ_API_KEY=

# Optional: override the default model (default: llama-3.3-70b-versatile)
# MYERS_LLM_MODEL=llama-3.1-8b-instant

